<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.poli.sw2Hexagonal.infraestructura.ui.ControlFormDrone"
      prefWidth="720" prefHeight="640">

  <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">

    <!-- ===================== Pestaña 1: CRUD + Observer ===================== -->
    <Tab text="Drones">
      <ScrollPane fitToWidth="true">
        <VBox spacing="12">
          <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
          </padding>

          <GridPane hgap="10" vgap="8">
            <Label text="Id" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Serial" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="txtSerial" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Modelo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="txtModelo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Fabricante" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="txtFabricante" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Peso" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="txtPeso" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Tipo" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbTipo" prefWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          </GridPane>

          <HBox spacing="8">
            <Button text="Crear" onAction="#onCrear"/>
            <Button text="Buscar por id" onAction="#onBuscar"/>
            <Button text="Modificar" onAction="#onModificar"/>
            <Button text="Eliminar" onAction="#onEliminar"/>
            <Button text="Limpiar" onAction="#onLimpiar"/>
          </HBox>

          <TableView fx:id="tblDrones" prefHeight="240">
            <columns>
              <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
              <TableColumn fx:id="colSerial" text="Serial" prefWidth="110"/>
              <TableColumn fx:id="colModelo" text="Modelo" prefWidth="110"/>
              <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="120"/>
              <TableColumn fx:id="colPeso" text="Peso" prefWidth="70"/>
              <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
            </columns>
          </TableView>

          <!-- ================= Observer ================= -->
          <Separator/>
          <Label text="Notificaciones de clima (Observer)"
                 style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

          <HBox spacing="8">
            <Label text="Observers:"/>
            <CheckBox fx:id="chkConsola" text="Consola" selected="true"/>
            <CheckBox fx:id="chkLogger" text="Logger" selected="true"/>
            <CheckBox fx:id="chkEstadoVuelo" text="Estado vuelo" selected="true"/>
            <CheckBox fx:id="chkDashboard" text="Dashboard" selected="true"/>
          </HBox>

          <HBox spacing="8">
            <Button text="Suscribir a seleccionados" onAction="#onSuscribir"/>
            <Button text="Desuscribir de seleccionados" onAction="#onDesuscribir"/>
            <Label fx:id="lblObservadores" text="Seleccione un dron"/>
          </HBox>

          <HBox spacing="8">
            <Label text="Ciudad" minWidth="60"/>
            <TextField fx:id="txtCiudadObserver" promptText="Ej: Bogotá" HBox.hgrow="ALWAYS"
                       onAction="#onNotificarClima"/>
            <Button fx:id="btnNotificarClima" text="Consultar y notificar" onAction="#onNotificarClima"/>
          </HBox>
        </VBox>
      </ScrollPane>
    </Tab>

    <!-- ================= Pestaña 2: Clima y viabilidad de vuelo (Chain) ================= -->
    <Tab text="Clima de vuelo">
      <ScrollPane fitToWidth="true">
        <VBox spacing="12">
          <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
          </padding>

          <HBox spacing="8">
            <Label text="Ciudad" minWidth="60"/>
            <TextField fx:id="txtCiudad" promptText="Ej: Bogotá" HBox.hgrow="ALWAYS"
                       onAction="#onConsultarClima"/>
            <Button fx:id="btnConsultarClima" text="Consultar clima" onAction="#onConsultarClima"/>
            <ProgressIndicator fx:id="prgClima" visible="false" prefWidth="22" prefHeight="22"/>
          </HBox>

          <GridPane hgap="10" vgap="6">
            <Label text="Ubicación" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblUbicacion" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Temperatura" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblTemperatura" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Humedad" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblHumedad" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Viento" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblViento" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Presión" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblPresion" text="—" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Visibilidad" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <Label fx:id="lblVisibilidad" text="—" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
          </GridPane>

          <Label fx:id="lblResultadoClima" wrapText="true" maxWidth="560"
                 style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

          <TextArea fx:id="txtDetalleCadena" editable="false" wrapText="true" prefRowCount="10"
                    promptText="Aquí aparece el detalle de la cadena de validaciones."/>
        </VBox>
      </ScrollPane>
    </Tab>

    <!-- ================= Pestaña 3: Consumo energético (Strategy) ================= -->
    <Tab text="Consumo energético">
      <ScrollPane fitToWidth="true">
        <VBox spacing="12">
          <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
          </padding>

          <GridPane hgap="10" vgap="8">
            <Label text="Dron" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbDroneConsumo" prefWidth="320" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Estrategia" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbEstrategia" prefWidth="320" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          </GridPane>

          <HBox spacing="8">
            <Button text="Cargar ruta (JSON)" onAction="#onCargarRuta"/>
            <Label fx:id="lblArchivoRuta" text="Ningún archivo cargado"/>
          </HBox>

          <GridPane hgap="10" vgap="6">
            <Label text="Origen" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblOrigen" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Destino" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblDestino" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
          </GridPane>

          <Button text="Calcular consumo" onAction="#onCalcularConsumo"/>

          <Separator/>

          <GridPane hgap="10" vgap="6">
            <Label text="Dron" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label fx:id="lblDroneConsumo" text="—" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

            <Label text="Distancia" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Label fx:id="lblDistancia" text="—" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Estrategia" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <Label fx:id="lblEstrategia" text="—" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

            <Label text="Cálculo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <Label fx:id="lblCalculo" text="—" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <Label text="Batería requerida" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <Label fx:id="lblBateria" text="—" style="-fx-font-weight: bold; -fx-font-size: 14px;"
                   GridPane.rowIndex="4" GridPane.columnIndex="1"/>
          </GridPane>
        </VBox>
      </ScrollPane>
    </Tab>
    
        <!-- ================= Pestaña 4: Misión (Command) ================= -->
    <Tab text="Misión">
      <ScrollPane fitToWidth="true">
        <VBox spacing="12">
          <padding>
            <Insets top="16" right="16" bottom="16" left="16"/>
          </padding>

          <HBox spacing="8">
            <Label text="Dron" minWidth="60"/>
            <ComboBox fx:id="cmbDroneMision" prefWidth="320"/>
          </HBox>

          <Label text="Agregar tarea" style="-fx-font-weight: bold;"/>
          <HBox spacing="8">
            <Button text="Tomar fotografía" onAction="#onAgregarFotografia"/>
            <Button text="Escanear zona" onAction="#onAgregarEscaneo"/>
            <Button text="Medir temperatura" onAction="#onAgregarTemperatura"/>
          </HBox>

          <Label text="Tareas programadas (en orden de ejecución)"/>
          <ListView fx:id="lstTareas" prefHeight="160"/>

          <HBox spacing="8">
            <Button text="Quitar seleccionada" onAction="#onQuitarTarea"/>
            <Button text="Limpiar tareas" onAction="#onLimpiarTareas"/>
            <Button text="Ejecutar misión" onAction="#onEjecutarMision"
                    style="-fx-font-weight: bold;"/>
          </HBox>

          <Label text="Resultados"/>
          <TextArea fx:id="txtResultadosMision" editable="false" wrapText="true" prefRowCount="8"
                    promptText="Aquí aparecen los resultados de la misión."/>
        </VBox>
      </ScrollPane>
    </Tab>

  </TabPane>
</VBox>