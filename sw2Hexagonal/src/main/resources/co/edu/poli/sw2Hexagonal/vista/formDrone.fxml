<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="co.edu.poli.sw2Hexagonal.infraestructura.ui.ControlFormDrone"
            fitToWidth="true" prefWidth="720" prefHeight="600">
  <content>
    <VBox spacing="12">
      <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
      </padding>

      <GridPane hgap="10" vgap="8">
        <Label text="Id" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Serial" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtSerial" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Modelo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtModelo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Fabricante" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtFabricante" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Peso" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPeso" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Tipo" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbTipo" prefWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
      </GridPane>

      <HBox spacing="8">
        <Button text="Crear" onAction="#onCrear"/>
        <Button text="Buscar por id" onAction="#onBuscar"/>
        <Button text="Modificar" onAction="#onModificar"/>
        <Button text="Eliminar" onAction="#onEliminar"/>
        <Button text="Limpiar" onAction="#onLimpiar"/>
      </HBox>

      <TableView fx:id="tblDrones" prefHeight="220">
        <columns>
          <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
          <TableColumn fx:id="colSerial" text="Serial" prefWidth="110"/>
          <TableColumn fx:id="colModelo" text="Modelo" prefWidth="110"/>
          <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="120"/>
          <TableColumn fx:id="colPeso" text="Peso" prefWidth="70"/>
          <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
        </columns>
      </TableView>

      <!-- ================= Clima (Observer) ================= -->
      <Separator/>
      <Label text="Clima (Observer)" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>

      <HBox spacing="8">
        <Label text="Observers:"/>
        <CheckBox fx:id="chkConsola" text="Consola" selected="true"/>
        <CheckBox fx:id="chkLogger" text="Logger" selected="true"/>
        <CheckBox fx:id="chkEstadoVuelo" text="Estado vuelo" selected="true"/>
        <CheckBox fx:id="chkDashboard" text="Dashboard" selected="true"/>
      </HBox>

      <HBox spacing="8">
        <Button text="Suscribir a seleccionados" onAction="#onSuscribir"/>
        <Button text="Desuscribir de seleccionados" onAction="#onDesuscribir"/>
        <Label fx:id="lblObservadores" text="Seleccione un dron"/>
      </HBox>

      <HBox spacing="8">
        <Label text="Ciudad"/>
        <TextField fx:id="txtCiudad" promptText="Ej: Bogotá" prefWidth="200"/>
        <Button fx:id="btnConsultarClima" text="Consultar clima" onAction="#onConsultarClima"/>
      </HBox>

      <GridPane hgap="10" vgap="4">
        <Label text="Temperatura:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="lblTemperatura" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Humedad:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="lblHumedad" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Velocidad del viento:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="lblViento" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Presión atmosférica:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="lblPresion" text="-" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Visibilidad:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <Label fx:id="lblVisibilidad" text="-" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
      </GridPane>
    </VBox>
  </content>
</ScrollPane>