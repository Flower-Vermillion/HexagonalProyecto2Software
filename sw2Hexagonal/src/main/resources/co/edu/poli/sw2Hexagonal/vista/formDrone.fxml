<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12" xmlns:fx="http://javafx.com/fxml"
      fx:controller="co.edu.poli.sw2Hexagonal.infraestructura.ui.ControlFormDrone">
  <padding>
    <Insets top="16" right="16" bottom="16" left="16"/>
  </padding>

  <GridPane hgap="10" vgap="8">
    <Label text="Id" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

    <Label text="Serial" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <TextField fx:id="txtSerial" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

    <Label text="Modelo" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <TextField fx:id="txtModelo" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

    <Label text="Fabricante" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <TextField fx:id="txtFabricante" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

    <Label text="Peso" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <TextField fx:id="txtPeso" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

    <Label text="Tipo" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
    <ComboBox fx:id="cmbTipo" prefWidth="200" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
  </GridPane>

  <HBox spacing="8">
    <Button text="Crear" onAction="#onCrear"/>
    <Button text="Buscar por id" onAction="#onBuscar"/>
    <Button text="Modificar" onAction="#onModificar"/>
    <Button text="Eliminar" onAction="#onEliminar"/>
    <Button text="Limpiar" onAction="#onLimpiar"/>
  </HBox>

  <TableView fx:id="tblDrones" prefHeight="260">
    <columns>
      <TableColumn fx:id="colId" text="Id" prefWidth="70"/>
      <TableColumn fx:id="colSerial" text="Serial" prefWidth="110"/>
      <TableColumn fx:id="colModelo" text="Modelo" prefWidth="110"/>
      <TableColumn fx:id="colFabricante" text="Fabricante" prefWidth="120"/>
      <TableColumn fx:id="colPeso" text="Peso" prefWidth="70"/>
      <TableColumn fx:id="colTipo" text="Tipo" prefWidth="110"/>
    </columns>
  </TableView>
</VBox>