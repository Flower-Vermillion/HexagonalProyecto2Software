diff --git a/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/dominio/state/DroneState.java b/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/dominio/state/DroneState.java
new file mode 100644
index 0000000..7e35cd3
