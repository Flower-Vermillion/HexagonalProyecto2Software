+++ b/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/dominio/state/DroneState.java
@@ -0,0 +1,67 @@
+package co.edu.poli.sw2Hexagonal.dominio.state;
+
+/**
+ * Interfaz State del patrón State: define las operaciones de un dron cuyo
+ * resultado depende de su estado operativo.
+ * <p>
+ * Cada operación devuelve el estado al que pasa el dron. Si la operación no
+ * está permitida en el estado actual, lanza {@link IllegalStateException} y
+ * el dron conserva su estado. Así, las transiciones válidas quedan definidas
+ * únicamente por las clases de estado.
+ * </p>
+ * <p>
+ * Ciclo operativo:
+ * </p>
+ * <pre>
+ *   APAGADO → EN ESPERA → VOLANDO → ATERRIZANDO → EN ESPERA
+ *                 ↓
+ *              APAGADO
+ * </pre>
+ */
+public interface DroneState {
+
+    /**
+     * @return nombre del estado operativo
+     */
+    String getNombre();
+
+    /**
+     * Enciende el dron.
+     *
+     * @return estado siguiente
+     * @throws IllegalStateException si la operación no está permitida
+     */
+    DroneState encender();
+
+    /**
+     * Apaga el dron.
+     *
+     * @return estado siguiente
+     * @throws IllegalStateException si la operación no está permitida
+     */
+    DroneState apagar();
+
+    /**
+     * Inicia el vuelo del dron.
+     *
+     * @return estado siguiente
+     * @throws IllegalStateException si la operación no está permitida
+     */
+    DroneState despegar();
+
+    /**
+     * Inicia el proceso de aterrizaje del dron.
+     *
+     * @return estado siguiente
+     * @throws IllegalStateException si la operación no está permitida
+     */
+    DroneState iniciarAterrizaje();
+
+    /**
+     * Finaliza el proceso de aterrizaje del dron.
+     *
+     * @return estado siguiente
+     * @throws IllegalStateException si la operación no está permitida
+     */
+    DroneState finalizarAterrizaje();
+}
diff --git a/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/dominio/state/FlyingState.java b/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/dominio/state/FlyingState.java
