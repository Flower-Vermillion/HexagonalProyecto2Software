+package co.edu.poli.sw2Hexagonal.aplicacion.puerto.entrada;
+
+import java.util.List;
+
+import co.edu.poli.sw2Hexagonal.dominio.modelo.Drone;
+
+/**
+ * Puerto de entrada — caso de uso: gestionar el estado operativo de un dron.
+ * <p>
+ * Las operaciones de transición devuelven el nombre del nuevo estado y lanzan
+ * {@link IllegalStateException} si el estado actual no las permite.
+ * </p>
+ */
+public interface ManageDroneStateUseCase {
+
+    /**
+     * Enciende un dron.
+     *
+     * @param drone dron a encender
+     * @return nombre del nuevo estado
+     * @throws IllegalStateException si el estado actual no lo permite
+     */
+    String encender(Drone drone);
+
+    /**
+     * Apaga un dron.
+     *
+     * @param drone dron a apagar
+     * @return nombre del nuevo estado
+     * @throws IllegalStateException si el estado actual no lo permite
+     */
+    String apagar(Drone drone);
+
+    /**
+     * Hace despegar un dron.
+     *
+     * @param drone dron que despega
+     * @return nombre del nuevo estado
+     * @throws IllegalStateException si el estado actual no lo permite
+     */
+    String despegar(Drone drone);
+
+    /**
+     * Inicia el aterrizaje de un dron.
+     *
+     * @param drone dron que aterriza
+     * @return nombre del nuevo estado
+     * @throws IllegalStateException si el estado actual no lo permite
+     */
+    String iniciarAterrizaje(Drone drone);
+
+    /**
+     * Finaliza el aterrizaje de un dron.
+     *
+     * @param drone dron que termina de aterrizar
+     * @return nombre del nuevo estado
+     * @throws IllegalStateException si el estado actual no lo permite
+     */
+    String finalizarAterrizaje(Drone drone);
+
+    /**
+     * Consulta el estado operativo de un dron.
+     *
+     * @param drone dron a consultar
+     * @return nombre del estado actual
+     */
+    String obtenerEstado(Drone drone);
+
+    /**
+     * Descarta el estado de los drones que ya no están registrados. Así, un
+     * dron nuevo creado con el id de uno eliminado inicia APAGADO.
+     *
+     * @param drones drones registrados actualmente
+     */
+    void sincronizar(List<? extends Drone> drones);
+}
diff --git a/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/aplicacion/servicio/DroneStateService.java b/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/aplicacion/servicio/DroneStateService.java
new file mode 100644
index 0000000..e48c694
--- /dev/null
+++ b/sw2Hexagonal/src/main/java/co/edu/poli/sw2Hexagonal/aplicacion/servicio/DroneStateService.java
@@ -0,0 +1,122 @@
+package co.edu.poli.sw2Hexagonal.aplicacion.servicio;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.stream.Collectors;
+
+import co.edu.poli.sw2Hexagonal.aplicacion.puerto.entrada.ManageDroneStateUseCase;
+import co.edu.poli.sw2Hexagonal.dominio.modelo.Drone;
+
+/**
+ * Servicio de aplicación — implementa la gestión del estado operativo.
+ * <p>
+ * Delega cada operación en el {@link Drone} (Context del patrón State), que a
+ * su vez la delega en su estado actual. Este servicio no contiene reglas de
+ * transición.
+ * </p>
+ * <p>
+ * El estado se maneja en memoria. Como la lista de drones se reconstruye al
+ * leer de la base de datos, el servicio conserva, por {@code id}, la instancia
+ * de {@link Drone} cuyo estado se ha modificado. Al reiniciar la aplicación
+ * todos los drones vuelven a APAGADO.
+ * </p>
+ */
+public class DroneStateService implements ManageDroneStateUseCase {
+
+    /** Drones con transiciones registradas, indexados por id. */
+    private final Map<String, Drone> dronesPorId = new ConcurrentHashMap<>();
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public String encender(Drone drone) {
+        Drone contexto = contexto(drone);
+        contexto.encender();
+        return contexto.getEstado().getNombre();
+    }
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public String apagar(Drone drone) {
+        Drone contexto = contexto(drone);
+        contexto.apagar();
+        return contexto.getEstado().getNombre();
+    }
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public String despegar(Drone drone) {
+        Drone contexto = contexto(drone);
+        contexto.despegar();
+        return contexto.getEstado().getNombre();
+    }
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public String iniciarAterrizaje(Drone drone) {
+        Drone contexto = contexto(drone);
+        contexto.iniciarAterrizaje();
+        return contexto.getEstado().getNombre();
+    }
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public String finalizarAterrizaje(Drone drone) {
+        Drone contexto = contexto(drone);
+        contexto.finalizarAterrizaje();
+        return contexto.getEstado().getNombre();
+    }
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public String obtenerEstado(Drone drone) {
+        return dronesPorId.getOrDefault(clave(drone), drone).getEstado().getNombre();
+    }
+
+    /**
+     * {@inheritDoc}
+     */
+    @Override
+    public void sincronizar(List<? extends Drone> drones) {
+        Set<String> vigentes = drones.stream().map(this::clave).collect(Collectors.toSet());
+        dronesPorId.keySet().retainAll(vigentes);
+    }
+
+    /**
+     * Obtiene la instancia que conserva el estado de un dron.
+     *
+     * @param drone dron recibido desde la interfaz
+     * @return instancia registrada para el id del dron
+     * @throws IllegalArgumentException si el dron es nulo o no tiene id
+     */
+    private Drone contexto(Drone drone) {
+        return dronesPorId.computeIfAbsent(clave(drone), id -> drone);
+    }
+
+    /**
+     * Obtiene la clave con la que se indexa un dron.
+     *
+     * @param drone dron
+     * @return id del dron
+     * @throws IllegalArgumentException si el dron es nulo o no tiene id
+     */
+    private String clave(Drone drone) {
+        if (drone == null || drone.getId() == null) {
+            throw new IllegalArgumentException("Debe seleccionar un dron");
+        }
+        return drone.getId();
+    }
+}
